# CybeDefend AppSec Community Edition: settings of `docker compose up -d`.
# Copy this file to .env next to docker-compose.yml, then fill the two
# required values. Every other value has a working default.
#
# The master key is not set here: it is the file secret-key next to
# docker-compose.yml, created once, readable by you alone:
#   (umask 077 && openssl rand -base64 32 > secret-key)
# Every encryption key and database password of the instance is derived from
# it, by the init-secrets job alone. Never change it, and back it up.

# ─── Master key ──────────────────────────────────────────────────────────────
# Host path of the master key file (at least 32 random bytes, base64 or hex), mounted into init-secrets only.
# CYBEDEFEND_SECRET_KEY_PATH=./secret-key
# The earlier way, still read (with a warning at each start) by an instance installed before the key file: the key itself here. Move it to the key file.
# CYBEDEFEND_SECRET_KEY=

# ─── Required ────────────────────────────────────────────────────────────────
# One-time token asked by the first-run setup page, which creates the first administrator. At least 32 characters: openssl rand -base64 32
CYBEDEFEND_SETUP_TOKEN=
# The address users open in their browser (scheme, host and port, no trailing slash).
CYBEDEFEND_PUBLIC_URL=http://localhost:8080

# ─── Instance ────────────────────────────────────────────────────────────────
# Image tag of the CybeDefend services (ghcr.io/cybedefend/cybedefend-*): the release this file comes from.
# Required: the compose file does not start without it, and never follows a moving tag such as latest.
CYBEDEFEND_VERSION=1.0.2
# Host address the published ports (web interface, storage, MCP server) listen on. The default, the host's
# loopback, keeps them off the network: put your TLS proxy, on this host, in front of them and expose only the
# proxy. Docker's firewall rules bypass the host's own (ufw, firewalld): a port published on 0.0.0.0 serves
# plain HTTP to every network the host is on. Set 0.0.0.0 only for a quick test on a trusted network; set the
# address of one interface (e.g. 10.0.0.12) when a proxy or the scan cluster reaches this host over that network.
# CYBEDEFEND_BIND_ADDRESS=127.0.0.1
# Host port of the web interface and the API (the API is served under /api).
CYBEDEFEND_HTTP_PORT=8080
# The address browsers use to reach the object storage (report downloads and uploads are signed for it).
CYBEDEFEND_STORAGE_PUBLIC_URL=http://localhost:9000
# Host port of the object storage (SeaweedFS, its S3 API).
CYBEDEFEND_STORAGE_PORT=9000
# Memory limits (Docker sizes) of file-management and of its cron, which filters the uploaded archives.
# CYBEDEFEND_FILE_MANAGEMENT_MEMORY=1g
# CYBEDEFEND_FILE_MANAGEMENT_CRON_MEMORY=2g
# Subnet of the front network (the web interface, mcp and the gateway); also the gateway's trusted proxy range, so only the bundled front may forward client addresses.
CYBEDEFEND_SUBNET=172.30.240.0/24
# Your TLS proxies in front of the web interface, if any: comma-separated IPv4/IPv6 addresses or CIDRs (empty: none).
# The front then takes each user's address from the X-Forwarded-For those proxies append. Without it, behind a proxy every
# user has the proxy's address, and shares one bucket in the sign-in, sign-up, setup, reset and invitation rate limits.
# Proxy on the same host: the first address of CYBEDEFEND_SUBNET (172.30.240.1 by default). Elsewhere: its address, e.g. 10.0.0.5.
# An invalid value stops the web interface at start, with a message.
# CYBEDEFEND_TRUSTED_PROXIES=
# Who may create an account: invite_only (an administrator invites each user) or open (anyone who reaches the sign-up page). open verifies no e-mail address: anyone can register a colleague's address before that colleague is invited; keep invite_only unless only trusted users can reach the instance.
AUTH_SIGNUP_MODE=invite_only

# true drops the Secure flag of the sign-in cookie, for a browser that refuses it on http://localhost, or for a public URL on http://host.docker.internal (what a local cluster's scan pods reach; every browser refuses a Secure cookie there over HTTP); the gateway refuses to start with it unless CYBEDEFEND_PUBLIC_URL's host is localhost, 127.0.0.1 or host.docker.internal.
# AUTH_COOKIE_INSECURE_LOCALHOST=false

# ─── Optional: scans on a Kubernetes cluster ─────────────────────────────────
# Without both of the first two values the instance only imports results (SARIF files sent by your CI).
# Path, inside the security-scanning containers, of a kubeconfig file you mount for the cluster that runs the scans.
# CYBEDEFEND_SCANNER_KUBECONFIG_FILE=
# Namespace the scanner pods are created in; set it together with CYBEDEFEND_SCANNER_KUBECONFIG_FILE.
# CYBEDEFEND_SCANNER_NAMESPACE=
# Registry and path of the scanner images, for a mirror (default: ghcr.io/cybedefend).
# CYBEDEFEND_SCANNER_IMAGE_REGISTRY=ghcr.io/cybedefend
# Tag of the scanner images (default: the version this release is compatible with).
# CYBEDEFEND_SCANNER_IMAGE_TAG=
# Name of a Secret in that namespace to pull the scanner images with (default: none).
# CYBEDEFEND_SCANNER_IMAGE_PULL_SECRET=
# How many scans run on the cluster at once, 1 to 50; the others wait in the queue.
# CYBEDEFEND_SCANNER_MAX_CONCURRENT=2
# How many scans of one organization run on the cluster at once, 1 to 50 (default: the maximum above); lower it to reserve slots for the other organizations.
# CYBEDEFEND_SCANNER_MAX_CONCURRENT_PER_ORGANIZATION=
# JSON overriding a scanner's CPU and memory, per adapter, for example {"trivy-fs":{"memoryLimit":"4Gi"}}.
# CYBEDEFEND_SCANNER_RESOURCES=
# true keeps finished scanner pods in the cluster, for debugging.
# CYBEDEFEND_SCANNER_KEEP_PODS=false
# true accepts a kubeconfig with insecure-skip-tls-verify: true or an http:// server (the API server is then not verified). Test clusters only.
# CYBEDEFEND_SCANNER_ALLOW_INSECURE_TLS=false
# Your mirror of Trivy's vulnerability database, for the SCA scanner pod (default: Trivy's public database).
# CYBEDEFEND_SCANNER_TRIVY_DB_REPOSITORY=
# Your mirror of Trivy's Java database, for the same pod (default: Trivy's public database).
# CYBEDEFEND_SCANNER_TRIVY_JAVA_DB_REPOSITORY=

# ─── Optional: stored reports ────────────────────────────────────────────────
# How many reports each organisation may keep stored (default 500; -1 for no limit). At the limit, new reports are
# refused until the organisation deletes some or they expire; nothing is deleted to make room.
# REPORTS_MAX_STORED_PER_ORG=500
# Days a new report is kept before the scheduled purge deletes it (default -1: never). The expiry is fixed when a
# report is created, so a change applies to new reports only.
# REPORTS_RETENTION_DAYS=-1

# ─── Optional: e-mail (SMTP) ─────────────────────────────────────────────────
# Without SMTP the instance sends no e-mail.
# SMTP server host name.
# EMAIL_HOST=
# SMTP port (587 for STARTTLS, 465 for implicit TLS).
# EMAIL_PORT=587
# true for implicit TLS (port 465), false for STARTTLS.
# EMAIL_SECURE=false
# SMTP user name.
# EMAIL_USER=
# SMTP password.
# EMAIL_PASSWORD=
# Sender of every e-mail, for example: CybeDefend <appsec@example.com>. Required when EMAIL_HOST is set; no default.
# EMAIL_FROM=

# ─── MCP server ──────────────────────────────────────────────────────────────
# The MCP server for coding agents starts with the stack.
# The address coding agents use to reach the MCP server.
# CYBEDEFEND_MCP_PUBLIC_URL=http://localhost:3010
# Host port of the MCP server.
# CYBEDEFEND_MCP_PORT=3010
# Browser pages allowed to call the MCP server: comma-separated http(s) origins
# (e.g. a browser MCP inspector's), or * for any. Empty: only its own address.
# CYBEDEFEND_MCP_ALLOWED_ORIGINS=

# ─── Optional: GitHub App ────────────────────────────────────────────────────
# Numeric id of your GitHub App.
# GITHUB_APP_ID=
# The App's private key (PEM), or, better, the file github/private-key.pem (see github/README.md) and GITHUB_PRIVATE_KEY_FILE below.
# GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_FILE=/run/cybedefend-github/private-key.pem
# Secret GitHub signs the App's webhooks with.
# GITHUB_WEBHOOK_SECRET=
# OAuth client id of the App.
# GITHUB_CLIENT_ID=
# OAuth client secret of the App.
# GITHUB_CLIENT_SECRET=
# The App's public page (https://github.com/apps/<name>), used by the interface's install link.
# GITHUB_APP_URL=

# ─── Optional: GitLab ────────────────────────────────────────────────────────
# API of your GitLab instance (default: https://gitlab.com/api/v4).
# GITLAB_API_URL=https://gitlab.com/api/v4
# Application id of the GitLab OAuth application.
# GITLAB_APPLICATION_ID=
# Secret of the GitLab OAuth application.
# GITLAB_APPLICATION_SECRET=

# ─── Optional: Jira ──────────────────────────────────────────────────────────
# OAuth client id of your Atlassian app.
# JIRA_CLIENT_ID=
# OAuth client secret of your Atlassian app.
# JIRA_CLIENT_SECRET=

# ─── Optional: Linear ────────────────────────────────────────────────────────
# OAuth client id of your Linear application.
# LINEAR_CLIENT_ID=
# OAuth client secret of your Linear application.
# LINEAR_CLIENT_SECRET=
# Signing secret of the application's webhook (<public URL>/api/webhooks/linear).
# LINEAR_WEBHOOK_SECRET=

# ─── Optional: Slack ─────────────────────────────────────────────────────────
# Client id of your Slack app.
# SLACK_CLIENT_ID=
# Client secret of your Slack app.
# SLACK_CLIENT_SECRET=
