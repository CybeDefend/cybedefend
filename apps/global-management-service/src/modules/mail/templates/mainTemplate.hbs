<!DOCTYPE html>
<html lang="en">
  <head>
  </head>
  <body>
    <div dir="ltr" class="es-wrapper-color" lang="en" style="background-color:#FAFAFA">
      <table width="100%" cellspacing="0" cellpadding="0" class="es-wrapper" role="none" style="padding:0;Margin:0;width:100%;height:100%;background-repeat:repeat;background-position:center top;background-color:#FAFAFA">
        <tr>
          <td valign="top" style="padding:0;Margin:0">
            {{> header }}
            <table cellpadding="0" cellspacing="0" align="center" class="es-content" role="none" style="width:100%;background-color:#FFFFFF;width:600px">
              <tr>
                <td align="center" style="padding:0;Margin:0">
                  <tr>
                    <td align="left" style="Margin:0;padding-bottom:55px;padding-top:40px;padding-right:50px;padding-left:50px">
                      <table cellpadding="0" cellspacing="0" width="100%" role="none">
                        <tr>
                          <td align="center" valign="top" style="padding:0;Margin:0;width:500px">
                            <table cellpadding="0" cellspacing="0" width="100%" role="presentation">
                              {{#each components}}
                                {{> (lookup . 'type') this}}
                              {{/each}}
                            </table>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </td>
              </tr>
            </table>
            {{> footer }}
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>
