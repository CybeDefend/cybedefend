<table
  role='presentation'
  cellpadding='0'
  cellspacing='0'
  width='100%'
  style='margin:18px 0;font-family:Arial,Helvetica,sans-serif;'
>
  <tr>
    {{#each metrics}}
      <td
        style='width:25%;padding:10px;border:1px solid #eee;text-align:center;vertical-align:top;'
      >
        <div
          style='font-size:12px;color:#666;text-transform:uppercase;letter-spacing:.5px;'
        >{{label}}</div>
        <div
          style='font-size:20px;font-weight:700;margin-top:4px;'
        >{{value}}</div>
        {{#if delta}}
          <div
            style='font-size:11px;margin-top:4px;color:{{deltaColor}};'
          >{{delta}}</div>
        {{/if}}
      </td>
    {{/each}}
  </tr>
</table>