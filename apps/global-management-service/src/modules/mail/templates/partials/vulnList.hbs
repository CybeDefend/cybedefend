<table
  role='presentation'
  cellpadding='0'
  cellspacing='0'
  width='100%'
  style='border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;margin:10px 0;font-size:13px;'
>
  <thead>
    <tr style='background:#fafafa;border:1px solid #e3e3e3;'>
  <th style='padding:6px 8px;text-align:left;'>Severity</th>
      <th style='padding:6px 8px;text-align:left;'>Type</th>
      <th style='padding:6px 8px;text-align:left;'>Title</th>
      <th style='padding:6px 8px;text-align:left;'>State</th>
      <th style='padding:6px 8px;text-align:left;'>CVSS</th>
      <th style='padding:6px 8px;text-align:left;'>Opened</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
      <tr style='border:1px solid #f0f0f0;'>
        <td style='padding:6px 8px;'>
          <span style='display:inline-block;background:#{{severityColor severity}};color:#fff;border-radius:4px;padding:2px 6px;font-size:11px;font-weight:700;text-transform:uppercase;'>{{severity}}</span>
        </td>
        <td style='padding:6px 8px;'>{{type}}</td>
        <td
          style='padding:6px 8px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;'
          title='{{title}}'
        >{{title}}</td>
        <td style='padding:6px 8px;'>{{state}}</td>
        <td style='padding:6px 8px;'>
          {{#if cvss}}
            {{> cvssBadge score=cvss bg=(cvssColor cvss)}}
          {{else}}
            <span style='color:#888;'>-</span>
          {{/if}}
        </td>
        <td style='padding:6px 8px;'>{{createdAt}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>
{{#if truncated}}
  <div style='font-size:11px;color:#666;font-style:italic;'>List truncated
    (showing first
    {{shown}}
    of
    {{total}}).</div>
{{/if}}