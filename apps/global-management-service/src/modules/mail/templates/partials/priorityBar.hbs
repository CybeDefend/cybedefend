<table
  width='100%'
  cellpadding='0'
  cellspacing='0'
  role='presentation'
  style='margin:10px 0 20px 0;'
>
  <tr>
    {{#each items}}
      <td
        style='text-align:center;font-size:12px;font-family:Arial;padding:4px 0;'
      >
        <div style='font-weight:600;color:#555;'>{{label}}</div>
        <div
          style='margin-top:4px;background:#eee;border-radius:4px;height:8px;overflow:hidden;'
        >
          <div
            style='width:{{percent}}%;height:8px;background:{{color}};'
          ></div>
        </div>
        <div style='margin-top:2px;color:#333;'>{{value}}</div>
      </td>
    {{/each}}
  </tr>
</table>