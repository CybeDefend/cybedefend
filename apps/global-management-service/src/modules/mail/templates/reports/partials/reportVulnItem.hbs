{{!-- Single Vulnerability Item (not table, beautiful list item) --}}
<tr>
  <td style='padding:12px 0;border-bottom:1px solid #f3f4f6;'>
    <table width='100%' cellpadding='0' cellspacing='0' role='presentation'>
      <tr>
        <td style='width:80px;vertical-align:top;padding-right:12px;'>
          {{> reportSeverityBadge severity=severity}}
        </td>
        <td style='vertical-align:top;'>
          <p style='margin:0;font-family:Arial,sans-serif;font-size:14px;color:#111827;line-height:1.5;word-break:break-word;'>
            {{title}}
          </p>
          {{#if packageName}}
            <p style='margin:4px 0 0 0;font-family:Arial,sans-serif;font-size:12px;color:#6b7280;'>
              Package: <span style='font-weight:600;color:#374151;'>{{packageName}}</span>{{#if version}} v{{version}}{{/if}}
            </p>
          {{/if}}
          {{#if cvss}}
            <p style='margin:4px 0 0 0;font-family:Arial,sans-serif;font-size:12px;color:#6b7280;'>
              CVSS Score: <span style='display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;background:{{cvssColor cvss}};color:#fff;'>{{cvss}}</span>
            </p>
          {{/if}}
          {{#if branch}}
            <p style='margin:4px 0 0 0;font-family:Arial,sans-serif;font-size:12px;color:#6b7280;'>
              &#127807; <span style='font-weight:600;color:#374151;'>{{branch}}</span>
            </p>
          {{/if}}
        </td>
      </tr>
    </table>
  </td>
</tr>
