{{!-- Project Section with Vulnerability List --}}
<table
  cellpadding='0'
  cellspacing='0'
  width='100%'
  role='presentation'
  style='margin:30px 0;'
>
  <tr>
    <td style='background:#ffffff;border-radius:12px;border:1px solid #e5e7eb;overflow:hidden;'>
      {{!-- Project Header --}}
      <table width='100%' cellpadding='0' cellspacing='0' role='presentation' style='background:linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);border-bottom:2px solid #e5e7eb;'>
        <tr>
          <td style='padding:20px 24px;'>
            <table width='100%' cellpadding='0' cellspacing='0' role='presentation'>
              <tr>
                <td style='vertical-align:middle;'>
                  <h3 style='margin:0;font-family:Arial,sans-serif;font-size:18px;color:#111827;font-weight:700;'>
                    {{projectName}}
                  </h3>
                  <p style='margin:6px 0 0 0;font-family:Arial,sans-serif;font-size:13px;color:#6b7280;'>
                    {{vulnerabilitiesCount}} vulnerabilities detected
                  </p>
                </td>
                <td align='right' style='vertical-align:middle;'>
                  <a
                    href='{{projectUrl}}' {{! cybedefend-ignore[CD-SAST-0455]: the server builds this URL from the configured FRONTEND_URL and a fixed path; no user or tenant value chooses its scheme }}
                    style='display:inline-block;background:#7845FF;color:#fff;text-decoration:none;padding:10px 20px;border-radius:6px;font-family:Arial,sans-serif;font-size:13px;font-weight:600;'
                  >
                    View Project
                  </a>
                </td>
              </tr>
            </table>
            
            {{!-- Severity Badges --}}
            {{#if severityCounts}}
            <table cellpadding='0' cellspacing='0' role='presentation' style='margin-top:12px;'>
              <tr>
                {{#if severityCounts.critical}}
                <td style='padding-right:8px;'>
                  <span style='display:inline-block;background:#FEE2E2;color:#991B1B;padding:4px 10px;border-radius:12px;font-family:Arial,sans-serif;font-size:11px;font-weight:600;border:1px solid #FECACA;'>
                    {{severityCounts.critical}} CRITICAL
                  </span>
                </td>
                {{/if}}
                {{#if severityCounts.high}}
                <td style='padding-right:8px;'>
                  <span style='display:inline-block;background:#FED7AA;color:#9A3412;padding:4px 10px;border-radius:12px;font-family:Arial,sans-serif;font-size:11px;font-weight:600;border:1px solid #FDBA74;'>
                    {{severityCounts.high}} HIGH
                  </span>
                </td>
                {{/if}}
                {{#if severityCounts.medium}}
                <td style='padding-right:8px;'>
                  <span style='display:inline-block;background:#FEF3C7;color:#92400E;padding:4px 10px;border-radius:12px;font-family:Arial,sans-serif;font-size:11px;font-weight:600;border:1px solid #FDE68A;'>
                    {{severityCounts.medium}} MEDIUM
                  </span>
                </td>
                {{/if}}
                {{#if severityCounts.low}}
                <td>
                  <span style='display:inline-block;background:#DBEAFE;color:#1E3A8A;padding:4px 10px;border-radius:12px;font-family:Arial,sans-serif;font-size:11px;font-weight:600;border:1px solid #BFDBFE;'>
                    {{severityCounts.low}} LOW
                  </span>
                </td>
                {{/if}}
              </tr>
            </table>
            {{/if}}
          </td>
        </tr>
      </table>

      {{!-- Vulnerabilities List --}}
      <table width='100%' cellpadding='0' cellspacing='0' role='presentation'>
        <tr>
          <td style='padding:20px 24px;'>
            <table width='100%' cellpadding='0' cellspacing='0' role='presentation'>
              {{#each vulnerabilities}}
                {{> reportVulnItem
                  severity=severity
                  title=title
                  packageName=packageName
                  version=version
                  cvss=cvss
                  branch=branch
                }}
              {{/each}}
            </table>

            {{#if hasMore}}
              <table width='100%' cellpadding='0' cellspacing='0' role='presentation' style='margin-top:16px;'>
                <tr>
                  <td align='center'>
                    <p style='margin:0;font-family:Arial,sans-serif;font-size:13px;color:#6b7280;font-style:italic;'>
                      + {{remainingCount}} more vulnerabilities not shown
                    </p>
                  </td>
                </tr>
              </table>
            {{/if}}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
