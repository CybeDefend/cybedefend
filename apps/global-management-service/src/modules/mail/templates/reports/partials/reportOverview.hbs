{{! Global Overview Section }}
<table
  cellpadding='0'
  cellspacing='0'
  width='100%'
  role='presentation'
  style='margin:30px 0;'
>
  <tr>
    <td
      style='background:#f9fafb;border-radius:12px;padding:30px;border:1px solid #e5e7eb;'
    >
      {{! Total Vulnerabilities Count }}
      <table width='100%' cellpadding='0' cellspacing='0' role='presentation'>
        <tr>
          <td align='center' style='padding-bottom:20px;'>
            <h2
              style='margin:0;font-family:Arial,sans-serif;font-size:18px;color:#374151;font-weight:600;'
            >
              {{totalVulnerabilities}}
              known vulnerabilities
            </h2>
          </td>
        </tr>
      </table>

      {{! Severity Badges }}
      <table width='100%' cellpadding='0' cellspacing='0' role='presentation'>
        <tr>
          <td align='center' style='padding:15px 0;'>
            <table
              cellpadding='0'
              cellspacing='0'
              role='presentation'
              style='display:inline-block;'
            >
              <tr>
                {{#each severities}}
                  <td style='padding:0 8px;'>
                    <div
                      style='background:{{color}};color:#fff;border-radius:8px;padding:12px 20px;text-align:center;min-width:80px;'
                    >
                      <div
                        style='font-size:24px;font-weight:700;margin-bottom:4px;'
                      >{{count}}</div>
                      <div
                        style='font-size:11px;text-transform:uppercase;letter-spacing:0.5px;opacity:0.95;'
                      >{{label}}</div>
                    </div>
                  </td>
                {{/each}}
              </tr>
            </table>
          </td>
        </tr>
      </table>

      {{! Call to Action }}
      <table width='100%' cellpadding='0' cellspacing='0' role='presentation'>
        <tr>
          <td align='center' style='padding-top:25px;'>
            <p
              style='margin:0 0 15px 0;font-family:Arial,sans-serif;font-size:14px;color:#6b7280;'
            >
              Review the status of your projects on your dashboard
            </p>
            <a
              href='{{dashboardUrl}}' {{! cybedefend-ignore[CD-SAST-0455]: the server builds this URL from the configured FRONTEND_URL and a fixed path; no user or tenant value chooses its scheme }}
              style='display:inline-block;background:#7845FF;color:#fff;text-decoration:none;padding:14px 32px;border-radius:8px;font-family:Arial,sans-serif;font-size:15px;font-weight:600;box-shadow:0 2px 8px rgba(120,69,255,0.3);'
            >
              View my projects
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>