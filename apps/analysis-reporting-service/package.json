{
  "name": "analysis-reporting-service",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "pnpm run proto:generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/src/worker.js",
    "prestart:worker:dev": "pnpm run proto:generate",
    "start:worker:dev": "node -r dotenv/config -r ts-node/register -r tsconfig-paths/register src/worker.ts",
    "start:worker:reports": "node dist/src/worker-reports.js",
    "prestart:worker:reports:dev": "pnpm run proto:generate",
    "start:worker:reports:dev": "node -r dotenv/config -r ts-node/register -r tsconfig-paths/register src/worker-reports.ts",
    "prestart:cron:report-mail": "pnpm run proto:generate",
    "start:cron:report-mail": "node -r ts-node/register -r tsconfig-paths/register src/main.cron-report-mail.ts",
    "prestart:cron:report-retention": "pnpm run proto:generate",
    "start:cron:report-retention": "node -r ts-node/register -r tsconfig-paths/register src/main.cron-report-retention.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart:dev": "pnpm run proto:generate",
    "start:debug": "nest start --debug --watch",
    "start:sync": "node --max-old-space-size=8192 dist/main.js",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "proto:generate": "protoc -I ../../libs/protos --plugin=protoc-gen-ts_proto=$(pwd)/node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=\"nestJs=true:src/core/grpc\" $(find ../../libs/protos -name '*.proto' -print | sed 's|../../libs/protos/||')",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d src/core/config/data-source.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d src/core/config/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d src/core/config/data-source.ts",
    "migration:show": "npx typeorm-ts-node-commonjs migration:show -d src/core/config/data-source.ts",
    "backfill:fingerprints": "node -r ts-node/register -r tsconfig-paths/register src/scripts/backfill-fingerprints.ts",
    "backfill:lifecycle": "node -r ts-node/register -r tsconfig-paths/register src/scripts/backfill-lifecycle.ts"
  },
  "dependencies": {
    "@cybedefend/db-dialect": "file:../../libs/db-dialect",
    "@cybedefend/realtime-publisher": "file:../../libs/realtime-publisher",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/axios": "^12.0.2",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/microservices": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/typeorm": "^12.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation-pino": "^0.66.0",
    "@opentelemetry/resources": "~2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "~2.9.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "ae-cvss-calculator": "^1.0.12",
    "axios": "^1.20.0",
    "bullmq": "^5.77.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.0",
    "joi": "^18.3.1",
    "mysql2": "^3.24.4",
    "nestjs-otel": "^8.1.1",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.21.0",
    "pino": "^10.4.0",
    "pino-opentelemetry-transport": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semver": "^7.8.1",
    "stream-json": "3.7.0",
    "typeorm": "^0.3.31",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "coverageProvider": "v8",
    "setupFiles": [
      "<rootDir>/core/db/jest.live-dialect.setup.ts"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@grpc/(global-management|security-scanning|analysis-reporting|agent|billing|secret-rotation|external-integrations|file-management|health)/(.*)$": "<rootDir>/core/grpc/$1/$2",
      "^@grpc/wrapper-grpc\\.module$": "<rootDir>/core/grpc/wrapper-grpc.module.ts",
      "^@grpc/grpc\\.module$": "<rootDir>/core/grpc/grpc.module.ts",
      "^@cybedefend/realtime-publisher$": "<rootDir>/../../../libs/realtime-publisher/src/index.ts",
      "^@cybedefend/db-dialect$": "<rootDir>/../../../libs/db-dialect/src/index.ts",
      "^puppeteer$": "<rootDir>/test-utils/puppeteer.mock.ts"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "<rootDir>/core/testing/esm-node-modules.transformer.js"
    },
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!(stream-chain@|stream-json@|@nestjs\\+))",
      "node_modules/(?!(\\.pnpm|stream-chain|stream-json|@nestjs))"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "msgpackr-extract",
      "protobufjs",
      "puppeteer",
      "unrs-resolver"
    ],
    "overrides": {
      "@babel/core@7": "^7.29.7",
      "@opentelemetry/core@2": "^2.8.0",
      "protobufjs@7": "^7.6.6",
      "protobufjs@8": "^8.6.6",
      "js-yaml@4": "^4.3.2",
      "multer": "^2.5.0",
      "body-parser": "^2.4.0",
      "qs": "^6.16.1",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@>=3": "^5.0.12",
      "fast-uri": "^3.1.9",
      "fast-copy": "^4.1.2",
      "form-data@2": "^2.5.6",
      "form-data@>=3": "^4.0.6",
      "js-yaml@3": "^3.15.2",
      "systeminformation": "^5.33.16",
      "tmp": "^0.2.7",
      "ws": "^8.21.3",
      "zod@3": "^4.6.7",
      "zod@4": "^4.6.7"
    }
  }
}
