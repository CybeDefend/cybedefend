{
  "name": "mcp-service",
  "version": "1.0.2",
  "description": "CybeDefend AppSec Model Context Protocol server (HTTP entry for AI coding assistants)",
  "author": "",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "pnpm run proto:generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "prestart:dev": "pnpm run proto:generate",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/e2e/jest-e2e.json",
    "proto:generate": "mkdir -p src/core/grpc && protoc -I ../../libs/protos --plugin=protoc-gen-ts_proto=$(pwd)/node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=\"nestJs=true:src/core/grpc\" $(find ../../libs/protos -name '*.proto' -print | sed 's|../../libs/protos/||')"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/microservices": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation-pino": "^0.66.0",
    "@opentelemetry/resources": "~2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "~2.9.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "5.12.8",
    "ioredis": "^5.11.1",
    "joi": "^18.3.2",
    "jose": "^6.2.18",
    "nestjs-otel": "^8.1.1",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.4.0",
    "pino-opentelemetry-transport": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.5",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "coverageProvider": "v8",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@grpc/(?!grpc-js/|proto-loader/)([a-z0-9-]+)/(.*)$": "<rootDir>/core/grpc/$1/$2"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "<rootDir>/core/testing/esm-node-modules.transformer.js"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!(@nestjs\\+))",
      "node_modules/(?!(\\.pnpm|@nestjs))"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "protobufjs",
      "unrs-resolver"
    ],
    "overrides": {
      "@babel/core@7": "^7.29.7",
      "@opentelemetry/core@2": "^2.8.0",
      "protobufjs@7": "^7.6.6",
      "protobufjs@8": "^8.6.6",
      "js-yaml@4": "^4.3.2",
      "multer": "^2.5.0",
      "fast-copy": "^4.1.2",
      "fastify": "$fastify",
      "find-my-way": "^9.7.0",
      "@hono/node-server": "^2.1.6",
      "hono": "^4.13.16",
      "body-parser": "^2.4.0",
      "qs": "^6.16.1",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@>=3": "^5.0.12",
      "fast-uri": "^3.1.9",
      "form-data@2": "^2.5.6",
      "form-data@>=3": "^4.0.6",
      "js-yaml@3": "^3.15.2",
      "systeminformation": "^5.33.16",
      "tmp": "^0.2.7",
      "ws": "^8.21.3",
      "ip-address": "^10.7.5",
      "zod@3": "^4.6.7",
      "zod@4": "^4.6.7"
    }
  }
}
