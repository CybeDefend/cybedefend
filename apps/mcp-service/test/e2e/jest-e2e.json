{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../",
  "testRegex": ".e2e-spec\\.ts$",
  "moduleNameMapper": {
    "^@grpc/(.*)$": "<rootDir>/src/core/grpc/$1",
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": ["<rootDir>/test/e2e/jest.setup.ts"],
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "transformIgnorePatterns": [
    "node_modules/\\.pnpm/(?!(jose|uuid)@)",
    "node_modules/(?!(\\.pnpm|jose|uuid))"
  ]
}
