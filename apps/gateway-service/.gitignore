# Generated ts-proto stubs (regenerated at build/dev via proto:generate).
# Top-level grpc.module.ts and wrapper-grpc.module.ts are hand-written and
# stay tracked; only the per-domain subdirectories are auto-generated and
# diverge from one machine to another after a `proto:generate` run.
/src/core/grpc/*/
