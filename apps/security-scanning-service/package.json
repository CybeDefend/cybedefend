{
  "name": "security-scanning-service",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "pnpm run proto:generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart:dev": "pnpm run proto:generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prestart:cron:dev": "pnpm run proto:generate",
    "start:cron:dev": "node -r ts-node/register -r tsconfig-paths/register src/main.cron.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "proto:generate": "protoc -I ../../libs/protos --plugin=protoc-gen-ts_proto=$(pwd)/node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=\"nestJs=true:src/core/grpc\" $(find ../../libs/protos -name '*.proto' -print | sed 's|../../libs/protos/||')",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d src/core/config/data-source.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d src/core/config/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d src/core/config/data-source.ts",
    "migration:show": "npx typeorm-ts-node-commonjs migration:show -d src/core/config/data-source.ts"
  },
  "dependencies": {
    "@cybedefend/db-dialect": "file:../../libs/db-dialect",
    "@cybedefend/realtime-publisher": "file:../../libs/realtime-publisher",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@kubernetes/client-node": "^1.4.0",
    "@nestjs/axios": "^12.0.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/microservices": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/typeorm": "^12.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation-pino": "^0.66.0",
    "@opentelemetry/resources": "~2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "~2.9.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "joi": "^18.3.2",
    "mysql2": "^3.24.6",
    "nestjs-otel": "^8.1.1",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.21.0",
    "pino": "^10.4.0",
    "pino-opentelemetry-transport": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "ulid": "^3.0.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.20.4",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.5",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "coverageProvider": "v8",
    "setupFiles": [
      "<rootDir>/core/db/jest.live-dialect.setup.ts"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@grpc/(global-management|iam|security-scanning|analysis-reporting|file-management|agent|billing|policy-management|health|external-integrations)/(.*)$": "<rootDir>/core/grpc/$1/$2",
      "^@grpc/wrapper-grpc\\.module$": "<rootDir>/core/grpc/wrapper-grpc.module.ts",
      "^@grpc/grpc\\.module$": "<rootDir>/core/grpc/grpc.module.ts",
      "^@kubernetes/client-node$": "<rootDir>/../test/mocks/k8s-client-node.ts",
      "^@cybedefend/realtime-publisher$": "<rootDir>/../../../libs/realtime-publisher/src/index.ts",
      "^@cybedefend/db-dialect$": "<rootDir>/../../../libs/db-dialect/src/index.ts"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "<rootDir>/core/testing/esm-node-modules.transformer.js"
    },
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!(uuid@|@nestjs\\+))",
      "node_modules/(?!(\\.pnpm|uuid|@nestjs))"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "forceExit": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "protobufjs",
      "unrs-resolver"
    ],
    "overrides": {
      "@opentelemetry/core@2": "^2.8.0",
      "protobufjs@7": "^7.6.6",
      "protobufjs@8": "^8.6.6",
      "js-yaml@4": "^4.3.2",
      "multer": "^2.5.0",
      "body-parser": "^2.4.0",
      "fast-copy": "^4.1.2",
      "qs": "^6.16.1",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@>=3": "^5.0.12",
      "fast-uri": "^3.1.9",
      "form-data@2": "^2.5.6",
      "form-data@>=3": "^4.0.6",
      "js-yaml@3": "^3.15.2",
      "systeminformation": "^5.33.16",
      "tmp": "^0.2.7",
      "ws": "^8.21.3",
      "ip-address": "^10.7.5",
      "zod@3": "^4.6.7",
      "zod@4": "^4.6.7"
    }
  }
}
