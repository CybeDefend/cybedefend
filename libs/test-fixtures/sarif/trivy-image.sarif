{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "fullName": "Trivy Vulnerability Scanner",
          "version": "0.76.1",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "rules": [
            {
              "id": "CVE-2023-2650",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-2650: OpenSSL signature verification bypass"
              },
              "fullDescription": {
                "text": "OpenSSL 3.1.0-r4 is vulnerable to signature verification bypass (CVE-2023-2650)."
              },
              "help": {
                "text": "Upgrade libcrypto3/libssl3 to 3.1.1-r0 or later. See https://avd.aquasec.com/nvd/cve-2023-2650 for CVE-2023-2650.",
                "markdown": "Upgrade libcrypto3/libssl3 to 3.1.1-r0 or later. See [CVE-2023-2650](https://avd.aquasec.com/nvd/cve-2023-2650)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2023-2650",
              "properties": {
                "precision": "very-high",
                "security-severity": "6.5",
                "tags": [
                  "vulnerability",
                  "security",
                  "MEDIUM"
                ]
              }
            },
            {
              "id": "CVE-2023-42363",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-42363: BusyBox tar extraction issue"
              },
              "fullDescription": {
                "text": "busybox 1.36.0-r9 is vulnerable to a tar extraction issue (CVE-2023-42363)."
              },
              "help": {
                "text": "Upgrade busybox to 1.36.1-r1 or later. See https://avd.aquasec.com/nvd/cve-2023-42363 for CVE-2023-42363.",
                "markdown": "Upgrade busybox to 1.36.1-r1 or later. See [CVE-2023-42363](https://avd.aquasec.com/nvd/cve-2023-42363)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2023-42363",
              "properties": {
                "precision": "very-high",
                "security-severity": "5.5",
                "tags": [
                  "vulnerability",
                  "security",
                  "MEDIUM"
                ]
              }
            },
            {
              "id": "CVE-2021-23337",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2021-23337: Command injection in lodash"
              },
              "fullDescription": {
                "text": "lodash versions prior to 4.17.21 are vulnerable to Command Injection via the template function (CVE-2021-23337)."
              },
              "help": {
                "text": "Upgrade lodash to 4.17.21 or later. See https://avd.aquasec.com/nvd/cve-2021-23337 for CVE-2021-23337.",
                "markdown": "Upgrade lodash to 4.17.21 or later. See [CVE-2021-23337](https://avd.aquasec.com/nvd/cve-2021-23337)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2021-23337",
              "properties": {
                "precision": "very-high",
                "security-severity": "7.2",
                "tags": [
                  "vulnerability",
                  "security",
                  "HIGH"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "ROOTPATH": {
          "uri": "file:///"
        }
      },
      "properties": {
        "imageName": "ghcr.io/example/api:2.0.1",
        "repoTags": [
          "ghcr.io/example/api:2.0.1"
        ],
        "repoDigests": [],
        "imageID": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
      },
      "results": [
        {
          "ruleId": "CVE-2023-2650",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Package: libcrypto3\nInstalled Version: 3.1.0-r4\nVulnerability CVE-2023-2650\nSeverity: MEDIUM\nFixed Version: 3.1.1-r0\nLink: [CVE-2023-2650](https://avd.aquasec.com/nvd/cve-2023-2650)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ghcr.io/example/api",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2023-2650",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Package: libssl3\nInstalled Version: 3.1.0-r4\nVulnerability CVE-2023-2650\nSeverity: MEDIUM\nFixed Version: 3.1.1-r0\nLink: [CVE-2023-2650](https://avd.aquasec.com/nvd/cve-2023-2650)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ghcr.io/example/api",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2023-42363",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Package: busybox\nInstalled Version: 1.36.0-r9\nVulnerability CVE-2023-42363\nSeverity: MEDIUM\nFixed Version: 1.36.1-r1\nLink: [CVE-2023-42363](https://avd.aquasec.com/nvd/cve-2023-42363)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ghcr.io/example/api",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2021-23337",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Package: lodash\nInstalled Version: 4.17.20\nVulnerability CVE-2021-23337\nSeverity: HIGH\nFixed Version: 4.17.21\nLink: [CVE-2021-23337](https://avd.aquasec.com/nvd/cve-2021-23337)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/package-lock.json",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
