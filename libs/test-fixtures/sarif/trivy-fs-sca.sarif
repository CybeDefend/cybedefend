                  "MEDIUM"
                ]
              }
            },
            {
              "id": "CVE-2023-32681",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-32681: ReDoS in requests"
              },
              "fullDescription": {
                "text": "requests versions prior to 2.31.0 are vulnerable to Regular expression denial of service (CVE-2023-32681)."
              },
              "help": {
                "text": "Upgrade requests to 2.31.0 or later. See https://avd.aquasec.com/nvd/cve-2023-32681 for CVE-2023-32681.",
