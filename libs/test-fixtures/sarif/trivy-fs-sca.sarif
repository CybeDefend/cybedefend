{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "fullName": "Trivy Vulnerability Scanner",
          "version": "0.76.1",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "rules": [
            {
              "id": "CVE-2021-23337",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2021-23337: Command injection in lodash"
              },
              "fullDescription": {
                "text": "lodash versions prior to 4.17.21 are vulnerable to Command Injection via the template function (CVE-2021-23337)."
              },
              "help": {
                "text": "Upgrade lodash to 4.17.21 or later. See https://avd.aquasec.com/nvd/cve-2021-23337 for CVE-2021-23337.",
                "markdown": "Upgrade lodash to 4.17.21 or later. See [CVE-2021-23337](https://avd.aquasec.com/nvd/cve-2021-23337)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2021-23337",
              "properties": {
                "precision": "very-high",
                "security-severity": "7.2",
                "tags": [
                  "vulnerability",
                  "security",
                  "HIGH"
                ]
              }
            },
            {
              "id": "CVE-2022-24999",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2022-24999: Regular expression denial of service in qs"
              },
              "fullDescription": {
                "text": "qs versions prior to 6.10.3 are vulnerable to Regular expression denial of service (CVE-2022-24999)."
              },
              "help": {
                "text": "Upgrade qs to 6.10.3, 6.9.7, 6.7.3, 6.5.3, 6.4.1, 6.3.3 or 6.2.4. See https://avd.aquasec.com/nvd/cve-2022-24999 for CVE-2022-24999.",
                "markdown": "Upgrade qs to 6.10.3, 6.9.7, 6.7.3, 6.5.3, 6.4.1, 6.3.3 or 6.2.4. See [CVE-2022-24999](https://avd.aquasec.com/nvd/cve-2022-24999)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2022-24999",
              "properties": {
                "precision": "very-high",
                "security-severity": "7.5",
                "tags": [
                  "vulnerability",
                  "security",
                  "HIGH"
                ]
              }
            },
            {
              "id": "CVE-2023-26136",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2023-26136: Cookie parsing out-of-bounds in tough-cookie"
              },
              "fullDescription": {
                "text": "tough-cookie versions prior to 4.1.3 are vulnerable to out-of-bounds cookie parsing (CVE-2023-26136)."
              },
              "help": {
                "text": "Upgrade tough-cookie to 4.1.3 or later. See https://avd.aquasec.com/nvd/cve-2023-26136 for CVE-2023-26136.",
                "markdown": "Upgrade tough-cookie to 4.1.3 or later. See [CVE-2023-26136](https://avd.aquasec.com/nvd/cve-2023-26136)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2023-26136",
              "properties": {
                "precision": "very-high",
                "security-severity": "6.5",
                "tags": [
                  "vulnerability",
                  "security",
                  "MEDIUM"
                ]
              }
            },
            {
              "id": "CVE-2023-28155",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
