{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "fullName": "Trivy Vulnerability Scanner",
          "version": "0.76.1",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "rules": [
            {
              "id": "CVE-2021-23337",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2021-23337: Command injection in lodash"
              },
              "fullDescription": {
                "text": "lodash versions prior to 4.17.21 are vulnerable to Command Injection via the template function (CVE-2021-23337)."
              },
              "help": {
                "text": "Upgrade lodash to 4.17.21 or later. See https://avd.aquasec.com/nvd/cve-2021-23337 for CVE-2021-23337.",
                "markdown": "Upgrade lodash to 4.17.21 or later. See [CVE-2021-23337](https://avd.aquasec.com/nvd/cve-2021-23337)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2021-23337",
              "properties": {
                "precision": "very-high",
                "security-severity": "7.2",
                "tags": [
                  "vulnerability",
                  "security",
                  "HIGH"
                ]
              }
            },
            {
              "id": "AVD-DS-0002",
              "name": "Misconfiguration",
              "shortDescription": {
                "text": "Image user should not be 'root'"
              },
              "helpUri": "https://avd.aquasec.com/misconfig/ds002",
              "properties": {
                "precision": "very-high",
                "security-severity": "8.0",
                "tags": [
                  "misconfiguration",
                  "security",
                  "HIGH"
                ]
              }
            },
            {
              "id": "aws-access-key-id",
              "name": "Secret",
              "shortDescription": {
                "text": "AWS Access Key ID"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "9.5",
                "tags": [
                  "secret",
                  "security",
                  "CRITICAL"
                ]
              }
            },
            {
              "id": "GPL-3.0-only",
              "name": "License",
              "shortDescription": {
                "text": "GPL-3.0-only"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "7.0",
                "tags": [
                  "license",
                  "security",
                  "HIGH"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "ROOTPATH": {
          "uri": "file:///"
        }
      },
      "results": [
        {
          "ruleId": "CVE-2021-23337",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Package: lodash\nInstalled Version: 4.17.20\nVulnerability CVE-2021-23337\nSeverity: HIGH\nFixed Version: 4.17.21\nLink: [CVE-2021-23337](https://avd.aquasec.com/nvd/cve-2021-23337)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-lock.json",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "AVD-DS-0002",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Artifact: Dockerfile\nType: dockerfile\nVulnerability AVD-DS-0002\nSeverity: HIGH\nMessage: Specify at least 1 USER command in Dockerfile with non-root user as argument\nLink: [AVD-DS-0002](https://avd.aquasec.com/misconfig/ds002)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "aws-access-key-id",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Artifact: config/settings.py\nType: \nSecret AWS Access Key ID\nSeverity: CRITICAL\nMatch: AWS_ACCESS_KEY_ID=********************"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "config/settings.py",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 4,
                  "endLine": 4
                }
              }
            }
          ]
        },
        {
          "ruleId": "GPL-3.0-only",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "Artifact: package-lock.json\nType: npm\nLicense GPL-3.0-only\nSeverity: HIGH\nPackage: copyleft-lib\nLink: [GPL-3.0-only](https://spdx.org/licenses/GPL-3.0-only.html)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-lock.json",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
