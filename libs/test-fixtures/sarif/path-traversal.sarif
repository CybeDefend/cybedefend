{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "rules": [
            {
              "id": "pt-01",
              "name": "pt-01"
            },
            {
              "id": "pt-02",
              "name": "pt-02"
            },
            {
              "id": "pt-03",
              "name": "pt-03"
            },
            {
              "id": "pt-04",
              "name": "pt-04"
            },
            {
              "id": "pt-05",
              "name": "pt-05"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "pt-01",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "path escapes the root"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "../../etc/passwd"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "pt-02",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "path escapes the root"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/../../secrets.py"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "pt-03",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "empty path"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ""
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "pt-04",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "scheme-only uri"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file:///"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "pt-05",
          "ruleIndex": 4,
          "level": "error",
          "message": {
            "text": "ok"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/ok.py"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
