{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "fullName": "Trivy Vulnerability Scanner",
          "version": "0.76.1",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "rules": [
            {
              "id": "CVE-2021-23337",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2021-23337: Command injection in lodash"
              },
              "fullDescription": {
                "text": "lodash versions prior to 4.17.21 are vulnerable to Command Injection via the template function (CVE-2021-23337)."
              },
              "help": {
                "text": "Upgrade lodash to 4.17.21 or later. See https://avd.aquasec.com/nvd/cve-2021-23337 for CVE-2021-23337.",
                "markdown": "Upgrade lodash to 4.17.21 or later. See [CVE-2021-23337](https://avd.aquasec.com/nvd/cve-2021-23337)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2021-23337",
              "properties": {
                "precision": "very-high",
                "security-severity": "7.2",
                "tags": [
                  "vulnerability",
                  "security",
                  "HIGH"
                ]
              }
            },
            {
              "id": "CVE-2020-8203",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2020-8203: Prototype pollution in lodash"
              },
              "fullDescription": {
                "text": "lodash versions prior to 4.17.19 are vulnerable to Prototype Pollution (CVE-2020-8203)."
              },
              "help": {
                "text": "Upgrade lodash to 4.17.19 or later. See https://avd.aquasec.com/nvd/cve-2020-8203 for CVE-2020-8203.",
                "markdown": "Upgrade lodash to 4.17.19 or later. See [CVE-2020-8203](https://avd.aquasec.com/nvd/cve-2020-8203)."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2020-8203",
              "properties": {
                "precision": "very-high",
                "security-severity": "7.4",
                "tags": [
                  "vulnerability",
                  "security",
                  "HIGH"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "ROOTPATH": {
          "uri": "file:///"
        }
      },
      "results": [
        {
          "ruleId": "CVE-2021-23337",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Package: lodash\nInstalled Version: 4.17.20\nVulnerability CVE-2021-23337\nSeverity: HIGH\nFixed Version: 4.17.21\nLink: [CVE-2021-23337](https://avd.aquasec.com/nvd/cve-2021-23337)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-lock.json",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2020-8203",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Package: lodash\nVulnerability CVE-2020-8203\nSeverity: HIGH\nFixed Version: 4.17.19\nLink: [CVE-2020-8203](https://avd.aquasec.com/nvd/cve-2020-8203)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-lock.json",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
