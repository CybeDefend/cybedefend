{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gosec",
          "rules": [
            {
              "id": "G204",
              "name": "subprocess-launched-with-variable",
              "properties": {
                "tags": [
                  "CWE-78"
                ]
              }
            },
            {
              "id": "G304",
              "name": "file-path-provided-as-taint-input",
              "properties": {
                "tags": [
                  "CWE-22"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "SRCROOT": {
          "uri": "file:///home/runner/work/app/app/"
        },
        "WEB": {
          "uri": "web/",
          "uriBaseId": "SRCROOT"
        }
      },
      "results": [
        {
          "ruleId": "G204",
          "level": "warning",
          "message": {
            "text": "Subprocess launched with a variable"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.go",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ]
        },
        {
          "ruleId": "G304",
          "level": "warning",
          "message": {
            "text": "Potential file inclusion via variable"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "index.js",
                  "uriBaseId": "WEB"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "G304",
          "level": "warning",
          "message": {
            "text": "Potential file inclusion via variable"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file:///src/lib/util.go"
                },
                "region": {
                  "startLine": 7
                }
              }
            }
          ]
        },
        {
          "ruleId": "G204",
          "level": "warning",
          "message": {
            "text": "Subprocess launched with a variable"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "./cmd/server.go"
                },
                "region": {
                  "startLine": 15
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
