{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "rules": [
            {
              "id": "sql-injection",
              "name": "sql-injection",
              "properties": {
                "tags": [
                  "CWE-89"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "sql-injection",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Possible SQL injection"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "api/orders.py"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ]
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "sql-injection",
              "name": "SQL injection",
              "properties": {
                "tags": [
                  "external/cwe/cwe-89"
                ],
                "security-severity": "9.1"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "sql-injection",
          "ruleIndex": 0,
          "message": {
            "text": "Database query built from user-controlled sources"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "api/orders.py"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ]
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "Bandit",
          "rules": [
            {
              "id": "B608",
              "name": "hardcoded_sql_expressions",
              "properties": {
                "tags": [
                  "CWE-89"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "B608",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Possible hardcoded SQL expression"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "api/report.py"
                },
                "region": {
                  "startLine": 40
                }
              }
            }
          ]
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "njsscan",
          "rules": []
        }
      },
      "results": []
    }
  ]
}
